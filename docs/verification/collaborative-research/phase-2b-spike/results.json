  "design": {
    "repo_path": "<artifact>/.ara/vcs/repo",
    "init": "ReadonlyRepo::init + GitBackend::init_internal(Sha1), no Workspace, no working copy; initialized in a sibling temp dir then renamed into place",
    "config": "StackedConfig::with_defaults() + one ConfigSource::CommandArg layer: user ara <ara@localhost>, debug.commit-timestamp=debug.operation-timestamp=1970-01-01T00:00:00Z, debug.randomness-seed=0, operation.hostname/username=ara, signing.backend=none, signing.behavior=drop",
    "commit_tree": "ara/<path> (exec bit = mode&0o111) + snapshot.json (original canonical manifest bytes); full modes come from the manifest",
    "change_id": "first 16 bytes of the capture id hash (deterministic, unique per capture)",
    "index": "one local bookmark per capture (capture-<hex>) in the operation view; list = parent walk from the single head, cross-checked against the bookmarks",
    "git_env_isolation": "process start: remove GIT_CONFIG_COUNT/GIT_CONFIG_PARAMETERS/GIT_CONFIG/GIT_CONFIG_SYSTEM, set GIT_CONFIG_NOSYSTEM=1 and GIT_CONFIG_GLOBAL=/dev/null"
  },
